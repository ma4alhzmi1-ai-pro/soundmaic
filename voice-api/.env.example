PORT=3000
# Set by the managed Webdev secret store; never commit a real value.
ELEVENLABS_API_KEY=
# Optional custom voice ID for the young_woman profile; configure only on the backend.
ELEVENLABS_YOUNG_WOMAN_VOICE_ID=
# Number of trusted reverse-proxy hops that append to X-Forwarded-For. Confirm this for your host.
TRUSTED_PROXY_HOPS=1
